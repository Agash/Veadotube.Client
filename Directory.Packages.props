<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- $(DotNetPackageVersion) follows the target framework; Directory.Build.targets sets it. -->
  <ItemGroup>
    <PackageVersion
      Include="Microsoft.Extensions.DependencyInjection"
      Version="$(DotNetPackageVersion)"
    />
    <PackageVersion
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="$(DotNetPackageVersion)"
    />
    <PackageVersion
      Include="Microsoft.Extensions.Logging.Abstractions"
      Version="$(DotNetPackageVersion)"
    />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(DotNetPackageVersion)" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
</Project>
